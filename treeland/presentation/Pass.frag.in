layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 outputColor;
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 outputSize;
};
layout(binding = 1) uniform sampler2D inputImage;
@shader_define@
@shader_algorithm@
@shader_pass@
